# 이 파일을 .env.local로 복사해 값을 채운다 (.env.local은 커밋되지 않는다)
#   macOS/Linux: cp .env.example .env.local      Windows cmd: copy .env.example .env.local

# ─── Gemini (필수) ───────────────────────────────────────────
# Gemini API 키 — 서버에서만 읽는다. https://aistudio.google.com/apikey
# 운영에서는 유료(결제 연결) 키나 Vertex AI를 쓴다: 무료 등급에서는 요청 내용이 Google 제품 개선에 쓰일 수 있다.
GEMINI_API_KEY=

# 사용할 모델 (선택, 기본값 gemini-flash-latest)
# 운영에서는 버전을 고정하는 것을 권장한다. 예: gemini-3.5-flash
GEMINI_MODEL=

# 요청 하나의 전체 제한 시간(ms, 선택, 기본 50000, 10000–55000)
GEMINI_TIMEOUT_MS=

# 사고 수준 (선택: minimal | low | medium | high, 기본값은 모델 기본)
# thinkingLevel을 지원하는 Gemini 3 계열 모델에서만 지정한다. 낮출수록 빠르고 저렴하다.
GEMINI_THINKING_LEVEL=

# ─── 결제 스위치 ─────────────────────────────────────────────
# 비워 두면(기본) 무료 전면 개방: 이름 3개·사주/한자 상세 풀이·도장 PNG·증명서 PDF를 결제 없이 보여 주고
# Stripe 결제 버튼을 숨긴다. true로 바꾸면 무료 미리보기 + $3.99 프리미엄 결제를 켠다 (아래 Stripe 값 필요).
# 빌드 때 코드에 박히므로 바꾸면 dev 서버를 다시 켜거나 다시 배포한다.
NEXT_PUBLIC_PAYWALL_ENABLED=

# ─── Stripe (페이월을 켤 때만 필요) ───────────────────────────
# 비밀 키 — 대시보드 › 개발자 › API 키. 테스트는 sk_test_…, 운영은 sk_live_…
STRIPE_SECRET_KEY=

# 웹훅 서명 비밀 whsec_…
#   로컬: `stripe listen --forward-to localhost:3000/api/stripe-webhook`이 출력하는 값
#   운영: 대시보드 › 웹훅 › 엔드포인트(https://<도메인>/api/stripe-webhook)의 서명 비밀
STRIPE_WEBHOOK_SECRET=

# (선택) 대시보드에 만든 상품 ID prod_… — 결제 내역을 한 상품으로 모은다. 금액은 코드의 $3.99를 쓴다
STRIPE_PRODUCT_ID=

# 사이트 대표 주소 — 결제 복귀 주소, canonical·sitemap·robots·공유 카드(OG)·JSON-LD가 모두 쓴다.
# 운영에서는 꼭 지정한다. 예: https://kname.studio (비우면 Vercel 주소 → http://localhost:3000)
APP_URL=

# ─── 풀이 저장소 ─────────────────────────────────────────────
# 비워 두면 로컬 파일(.data/kv)에 저장한다 — npm run dev / 단일 서버용.
# Vercel 같은 서버리스에서는 Upstash Redis가 필요하다 (Vercel KV의 KV_REST_API_URL·KV_REST_API_TOKEN도 인식).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (선택) 파일 저장소 위치 (기본: <프로젝트>/.data/kv)
READING_STORE_DIR=

# ─── Google AdSense (선택: 무료 화면 광고) ─────────────────────
# 비워 두면 광고를 싣지 않는다(개발 중에는 자리만 표시). 바꾸면 dev 서버를 다시 켠다(빌드 때 코드에 박힌다).
# 게시자 ID: AdSense › 계정 › 계정 정보 (ca-pub-로 시작하는 16자리)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# 광고 단위 ID: AdSense › 광고 › 광고 단위 기준 › 디스플레이 광고 (숫자)
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_READING=

# ─── 사이트 ──────────────────────────────────────────────────
# 고객 문의 이메일 — 푸터·개인정보처리방침·이용약관에 표시된다 (Stripe 심사·AdSense 승인에 필요)
NEXT_PUBLIC_SUPPORT_EMAIL=

# (선택) X(트위터) 계정 "@kname_studio" — 공유 카드에 표시
NEXT_PUBLIC_TWITTER_HANDLE=

# (선택) 검색 엔진 소유권 확인 — HTML 태그 방식의 content 값만 넣는다 (DNS로 확인했다면 비워 둔다)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ─── Google Analytics 4 (선택: 방문·전환 분석) ─────────────────
# 측정 ID G-XXXXXXXXXX — 비우면 GA 코드를 싣지 않는다. 바꾸면 dev 서버를 다시 켠다(빌드 때 코드에 박힌다).
# GA4에서 '향상된 측정 › 브라우저 기록 이벤트 기반 페이지 변경'을 꼭 끈다 (docs/DEPLOYMENT.md 6장)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Measurement Protocol API 비밀 — 있으면 결제 완료(purchase)를 서버가 보낸다 (광고 차단기와 무관, 중복 없음)
GA4_API_SECRET=
# (선택) EU 수집 엔드포인트: https://region1.google-analytics.com/mp/collect
GA4_MP_ENDPOINT=
# (테스트 전용) 1이면 테스트 결제도 GA4로 보낸다 — 운영에는 넣지 않는다
GA4_TRACK_TEST_PAYMENTS=

# ─── 매각 실사용 지표 (방문·퍼널·결제 원장) ─────────────────────
# auto(기본): Supabase → Upstash(위 저장소와 같은 DB) → 로컬 파일(.data/metrics.json) 순으로 고른다.
# kv | supabase | file | off 로 직접 고를 수 있다. Vercel 미리보기(Preview)에는 off를 넣는다.
METRICS_BACKEND=
# 방문자 해시 비밀 (무작위 64자) — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_SALT=
# 지표 내보내기 API(/api/admin/metrics) 토큰, 24자 이상 — 비우면 이 API는 404
METRICS_ADMIN_TOKEN=
# (선택) Supabase — supabase/migrations/20260929000000_kns_metrics.sql을 먼저 실행한다.
# 비밀 키 sb_secret_… (Settings › API Keys). 옛 service_role 키는 SUPABASE_SERVICE_ROLE_KEY로도 인식한다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# (선택) 파일 저장소 위치 (기본: <프로젝트>/.data/metrics.json)
METRICS_FILE=
